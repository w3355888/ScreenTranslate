<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="屏幕翻译 v1.1"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- 模式 A -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8F0FE"
            android:padding="14dp"
            android:layout_marginTop="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模式 A · 无障碍点译（推荐）"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:text="不截屏、直接读界面文字，本地离线翻译成中。可绕过 Maya 等金融 App 的防截屏限制，是全屏翻译能生效的关键。" />
            <Button
                android:id="@+id/btnAcc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="开启无障碍点译" />
        </LinearLayout>

        <!-- 模式 B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F1F1"
            android:padding="14dp"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模式 B · 截屏 OCR（兜底）"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:text="截屏后用本地 OCR 识别再翻译。若 Maya 开启防截屏，此模式会截到黑屏，此时请用模式 A。" />
            <Button
                android:id="@+id/btnShot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="开启截屏翻译" />
        </LinearLayout>

        <!-- 离线模型 -->
        <Button
            android:id="@+id/btnModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="下载离线翻译模型（首次需联网，建议挂菲律宾节点 VPN）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="13sp"
            android:textColor="#888888"
            android:text="说明：Maya 本身仍需菲律宾节点网络才能打开；本 App 只解决「英文界面→中文」的翻译问题，不解决联网问题。若手机无 Google 服务，可在 Translator.kt 填入你的本地 llama-server 地址走离线翻译。" />

    </LinearLayout>
</ScrollView>
